{
  "name": "@bjro/slog",
  "version": "1.1.0",
  "description": "A dead-simple structured logger for ECMAScript runtimes",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./hono": {
      "types": "./src/hono.ts",
      "import": "./src/hono.ts"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write ."
  },
  "license": "Apache-2.0",
  "author": "bjro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roobie/slog.git"
  },
  "bugs": {
    "url": "https://github.com/roobie/slog/issues"
  },
  "keywords": [
    "logger",
    "logging",
    "structured-logging",
    "json-logging",
    "log",
    "slog",
    "typescript",
    "hono",
    "middleware",
    "transport",
    "plugin",
    "redact",
    "bun",
    "deno",
    "node",
    "edge",
    "cloudflare-workers"
  ],
  "homepage": "https://github.com/roobie/slog#readme",
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^25.5.0",
    "hono": "^4.12.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
